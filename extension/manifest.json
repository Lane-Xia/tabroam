{
  "manifest_version": 3,
  "name": "TabRoam",
  "version": "1.0.5",
  "description": "Search tabs, bookmarks and history in one command bar. Switch windows, open URLs, or search the web with your chosen engine.",
  "minimum_chrome_version": "121",
  "permissions": ["activeTab", "scripting", "tabs", "history", "bookmarks", "storage", "favicon"],
  "background": { "service_worker": "background.mjs", "type": "module" },
  "action": { "default_title": "Open TabRoam", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space" },
      "description": "Open TabRoam"
    }
  },
  "options_page": "options.html",
  "incognito": "not_allowed",
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
